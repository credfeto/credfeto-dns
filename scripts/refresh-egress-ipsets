#!/bin/sh

# Keeps the dns-egress-* firewalld ipsets in sync with current DNS
# resolution for domains that have no stable static IP/CIDR to allow
# (CDN-fronted). See docs/network/egress-whitelist.md, open questions
# 9-10, for why these specific domains need this and why a static rule
# doesn't work for them.
#
# Runs as root - via the dns-egress-refresh.timer systemd unit that
# ./update installs, or manually with sudo.

set -eu

die() {
    echo
    echo "$@"
    exit 1
}

[ "$(id -u)" -eq 0 ] || die "must run as root"

# domain:slug pairs, not a mechanical domain-to-slug derivation — the
# kernel's ipset name limit is 32 bytes (IPSET_MAXNAMELEN), so slugs stay
# short by hand rather than risking a future domain producing a name
# that's silently too long. Keep in sync with the ipset/rule slug list in
# ./update if a domain is ever added, removed or renamed here.
DOMAIN_SLUGS="github.com:github cdn-mirror.chaotic.cx:chaotic pkgstats.archlinux.de:pkgstats openpgpkey.archlinux.org:archwkd"

CHANGED=false

# Reload via traps so it also fires when set -e aborts the run, or a
# signal (e.g. systemctl stop mid-run) kills it, after permanent entries
# were already mutated - otherwise runtime state strands behind
# permanent config, and later runs (seeing permanent == wanted,
# CHANGED=false) would never catch it up.
trap 'if [ "${CHANGED}" = "true" ]; then firewall-cmd --reload; CHANGED=false; fi' EXIT
trap 'exit 130' INT HUP TERM

# firewalld's own ipset entries are the source of truth for "current" -
# this script never keeps state of its own between runs. No-op when the
# wanted and current sets already match, so the reload at the end can be
# skipped on the (overwhelmingly common) unchanged run.
sync_ipset() {
    _set="$1"
    _wanted="$2"
    _current="$(firewall-cmd --permanent --ipset="${_set}" --get-entries 2>/dev/null || true)"

    if [ "$(printf '%s\n' "${_wanted}" | sort -u)" = "$(printf '%s\n' "${_current}" | sort -u)" ]; then
        return 0
    fi
    CHANGED=true

    printf '%s\n' "${_current}" | while IFS= read -r _ip; do
        [ -n "${_ip}" ] || continue
        printf '%s\n' "${_wanted}" | grep -Fqx "${_ip}" \
            || firewall-cmd --permanent --ipset="${_set}" --remove-entry="${_ip}" > /dev/null
    done

    printf '%s\n' "${_wanted}" | while IFS= read -r _ip; do
        [ -n "${_ip}" ] || continue
        printf '%s\n' "${_current}" | grep -Fqx "${_ip}" \
            || firewall-cmd --permanent --ipset="${_set}" --add-entry="${_ip}" > /dev/null
    done
}

for _pair in ${DOMAIN_SLUGS}; do
    _domain="${_pair%%:*}"
    _slug="${_pair#*:}"

    # One lookup per domain - separate per-family lookups can return
    # divergent snapshots under CDN rotation, and the NAT64 forms are
    # derived from the v4 answers, so a split view causes spurious churn.
    # A transiently unresolvable domain is skipped rather than aborting -
    # exiting mid-run after an earlier domain's permanent entries were
    # already mutated would strand runtime state (the reload below would
    # never run: later runs see permanent==wanted and skip it).
    _ahosts="$(getent ahosts "${_domain}")" || continue
    _v4="$(printf '%s\n' "${_ahosts}" | awk '$1 !~ /:/ {print $1}' | sort -u)"

    # v6 wanted-set = native AAAA answers plus the NAT64 well-known-prefix
    # (64:ff9b::/96, RFC 6052) form of every IPv4 address, deduplicated.
    # This network runs DNS64, so IPv6-preferring clients reach IPv4-only
    # destinations via these synthesised addresses - but whether a lookup
    # returns the synthesised AAAA depends on resolver state at that
    # instant, so resolver-returned 64:ff9b: forms are DROPPED here and
    # recomputed deterministically from the v4 answers instead. With this
    # script as the sets' only writer and firewalld returning entries
    # verbatim, the comparison is self-consistent by construction -
    # duplicate same-address spellings can't flap between runs. Unpadded
    # hex groups keep the common case aligned with RFC 5952 rendering.
    _v6="$( {
        printf '%s\n' "${_ahosts}" | awk '$1 ~ /:/ && tolower($1) !~ /^64:ff9b:/ {print $1}'
        printf '%s\n' "${_v4}" | awk -F. 'NF == 4 {printf "64:ff9b::%x:%x\n", $1 * 256 + $2, $3 * 256 + $4}'
    } | sort -u)"

    sync_ipset "dns-egress-${_slug}-v4" "${_v4}"
    sync_ipset "dns-egress-${_slug}-v6" "${_v6}"
done

# GitHub publishes its address ranges, so allow those as networks rather
# than chasing whichever single address github.com resolves to (it rotates
# every few minutes). The list ships in the repo (scripts/github-egress-
# ranges, installed by ./update) and is refreshed there with
# scripts/update-github-egress-ranges. The resolved-address github sets
# above stay as a fallback for any address GitHub hasn't published yet.
GITHUB_RANGES="/usr/local/share/credfeto-adguard-home/github-egress-ranges"

# Prints "+net" / "-net" lines to turn the current entries (stdin) into
# the wanted ones. Compares parsed networks, so firewalld's own rendering
# of an entry (e.g. dropping /32) can't cause churn and a needless reload.
# For v6 the wanted set is the native v6 ranges plus the NAT64 (64:ff9b::/96)
# form of every v4 range, matching the per-domain sets above.
#
# The Python goes in -c, not a heredoc: a heredoc would take over stdin,
# which has to carry the current entries.
ghnet_diff() {
    python3 -c '
import ipaddress, sys
family, path = int(sys.argv[1]), sys.argv[2]
nat64 = ipaddress.ip_network("64:ff9b::/96")
wanted = set()
with open(path) as f:
    for line in f:
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        net = ipaddress.ip_network(line, strict=False)
        if net.version == family:
            wanted.add(net)
        elif family == 6:
            base = int(nat64.network_address) + int(net.network_address)
            wanted.add(ipaddress.ip_network((base, 96 + net.prefixlen)))
current = {}
for line in sys.stdin:
    line = line.strip()
    if line:
        current[ipaddress.ip_network(line, strict=False)] = line
for net, raw in current.items():
    if net not in wanted:
        print("-" + raw)
for net in sorted(wanted - current.keys()):
    print("+" + str(net))
' "$1" "${GITHUB_RANGES}"
}

sync_ghnet() {
    _set="$1"
    _family="$2"
    _ops="$(firewall-cmd --permanent --ipset="${_set}" --get-entries 2>/dev/null | ghnet_diff "${_family}")" || return 0
    [ -n "${_ops}" ] || return 0
    CHANGED=true
    printf '%s\n' "${_ops}" | while IFS= read -r _op; do
        case "${_op}" in
            -*) firewall-cmd --permanent --ipset="${_set}" --remove-entry="${_op#-}" > /dev/null ;;
            +*) firewall-cmd --permanent --ipset="${_set}" --add-entry="${_op#+}" > /dev/null ;;
        esac
    done
}

if [ -r "${GITHUB_RANGES}" ] && command -v python3 > /dev/null; then
    sync_ghnet dns-egress-ghnet-v4 4
    sync_ghnet dns-egress-ghnet-v6 6
else
    echo "warning: ${GITHUB_RANGES} or python3 missing; GitHub ranges not synced (run ./update)" >&2
fi

# Reload happens in the EXIT trap above.
