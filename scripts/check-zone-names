#!/usr/bin/env python3
"""Fail if a zone holds a name that belongs in a sub-zone.

Two rules:

1. A forward zone's owner names are single labels below the zone. A name
   such as nas-01.storage in lan. belongs in its own zone (storage.lan.).
2. When a host in a sub-zone (dns-06.dns.lan.) also has a flat name in the
   parent zone (dns-06.lan.), the flat name is exactly one CNAME to the
   sub-zone name and nothing else.
"""

# The executable name uses kebab-case like the other scripts/ entry points.
# pylint: disable=invalid-name

from argparse import ArgumentParser

from zone_files import is_reverse_zone, run_check

ADDRESS_TYPES = frozenset({"A", "AAAA"})
NAME = "check-zone-names"


def is_below(name, zone_name):
    """Whether name is strictly below zone_name."""
    return name.endswith(f".{zone_name}")


def relative_labels(owner, zone_name):
    """The owner's labels below the zone, or None if it is outside it."""
    if owner == zone_name:
        return []
    if not is_below(owner, zone_name):
        return None
    return owner[: -len(zone_name) - 1].split(".")


def host_labels(labels):
    """The labels left once leading _service/_attribute labels are dropped.

    Names such as _sip._tcp or _acme-challenge.www are records about a
    name, not separate hosts, so only what follows the underscore labels
    counts towards the single-label rule.
    """
    index = 0
    while index < len(labels) and labels[index].startswith("_"):
        index += 1
    return labels[index:]


def location(zone, record):
    """The file:line prefix for a message about a record."""
    return f"{zone.path}:{record.line}"


def multi_label_errors(zones):
    """Report forward-zone owners that are more than one label deep."""
    errors = []
    for zone in zones:
        if is_reverse_zone(zone):
            continue
        reported = set()
        for record in zone.records:
            labels = relative_labels(record.owner, zone.name)
            if labels is None:
                errors.append(
                    f"{location(zone, record)}: {record.owner} is outside "
                    f"the {zone.name} zone; move it to its own zone file"
                )
                continue
            labels = host_labels(labels)
            if len(labels) < 2 or record.owner in reported:
                continue
            reported.add(record.owner)
            sub_zone = ".".join(labels[1:]) + f".{zone.name}"
            errors.append(
                f"{location(zone, record)}: {record.owner} is a multi-label "
                f"name in the {zone.name} zone; move it to the {sub_zone} "
                f"zone (zones/{sub_zone[:-1]}.db) as {labels[0]}"
            )
    return errors


def parent_zone(zone, zones):
    """The nearest loaded zone that zone is strictly below, if any."""
    parents = [other for other in zones if is_below(zone.name, other.name)]
    return max(parents, key=lambda other: len(other.name), default=None)


def sub_zone_hosts(zone):
    """The single-label owners in zone that have A/AAAA records."""
    hosts = []
    for record in zone.records:
        labels = relative_labels(record.owner, zone.name)
        if record.rtype not in ADDRESS_TYPES or labels is None:
            continue
        if len(labels) == 1 and record.owner not in hosts:
            hosts.append(record.owner)
    return hosts


def records_at(zone, owner):
    """Every record in zone owned by owner."""
    return [record for record in zone.records if record.owner == owner]


def flat_alias_error(parent, zone, host):
    """The message for a flat parent name that is not a CNAME to host."""
    label = host[: -len(zone.name) - 1]
    flat = f"{label}.{parent.name}"
    records = records_at(parent, flat)
    if not records:
        return None
    if len(records) == 1 and records[0].rtype == "CNAME":
        if records[0].data == host:
            return None
    types = ", ".join(sorted({record.rtype for record in records}))
    return (
        f"{location(parent, records[0])}: {flat} has {types} but {host} is "
        f"a host in {zone.path}; replace every {flat} record with exactly "
        f"'{label} IN CNAME {host}'"
    )


def flat_alias_errors(zones):
    """Report flat parent names for sub-zone hosts that are not CNAMEs."""
    errors = []
    for zone in zones:
        if is_reverse_zone(zone):
            continue
        parent = parent_zone(zone, zones)
        if parent is None:
            continue
        for host in sub_zone_hosts(zone):
            error = flat_alias_error(parent, zone, host)
            if error:
                errors.append(error)
    return errors


def check_zones(zones):
    """Return a message for each misplaced or non-CNAME flat name."""
    return multi_label_errors(zones) + flat_alias_errors(zones)


def main(argv=None, streams=None):
    """Command line entry point; returns the process exit code."""
    description = (
        "Check that every forward-zone owner is a single label (sub-zone "
        "names live in their own zone) and that a parent-zone name for a "
        "sub-zone host is only a CNAME to the sub-zone name."
    )
    parser = ArgumentParser(prog=NAME, description=description)
    success = "every name is in its own zone"
    return run_check(parser, check_zones, success, argv, streams)


if __name__ == "__main__":
    raise SystemExit(main())
