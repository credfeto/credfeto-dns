[Unit]
Description=Refresh and load the DNS server's egress nftables table
Wants=network-online.target
After=network-online.target firewalld.service
# Loaded at boot before Docker starts Technitium, so its traffic is never
# unfiltered. A failed or slow run does not stop Docker: Before= only orders.
Before=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/dns-egress
TimeoutStartSec=2min
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
