#!/bin/sh

set -e

die() {
    echo
    echo "$@"
    exit 1
}

IMPORT_ALL=false
case "$1" in
    --all) IMPORT_ALL=true ;;
    "")    ;;
    *)     die "Usage: sync-zones [--all]" ;;
esac

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$SCRIPTDIR")"

ENV_FILE="${SCRIPTDIR}/.env"
if [ ! -f "${ENV_FILE}" ]; then
    echo "sync-zones: no .env at ${ENV_FILE} — skipping zone sync."
    echo "sync-zones: copy scripts/.env.example and set DNS_API_TOKEN to enable."
    exit 0
fi

DNS_API_TOKEN="$(grep -E '^[[:space:]]*DNS_API_TOKEN[[:space:]]*=' "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
if [ -z "${DNS_API_TOKEN}" ]; then
    echo "sync-zones: DNS_API_TOKEN not set in ${ENV_FILE} — skipping zone sync."
    exit 0
fi

DNS_API_URL="$(grep -E '^[[:space:]]*DNS_API_URL[[:space:]]*=' "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
DNS_API_URL="${DNS_API_URL:-https://localhost:53443}"

configure_server() {
    echo "sync-zones: configuring server settings..."
    # dnsTlsCertificatePath=cert.pfx points to the self-signed cert generated by
    # the update script at /data/technitium/config/cert.pfx (mounted as /etc/dns/).
    # dnsTlsCertificatePassword is intentionally empty — the cert has no password.
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/settings/set?token=${DNS_API_TOKEN}&webServiceEnableHttp3=true&enableDnsOverHttps=true&dnsOverHttpsPort=443&enableDnsOverHttp3=true&dnsTlsCertificatePath=cert.pfx&dnsTlsCertificatePassword=" \
        > /dev/null \
        || echo "sync-zones: warning: server settings update failed" >&2
}

import_zone() {
    _ZONE_NAME="$(basename "$1" .db)"
    echo "sync-zones: importing ${_ZONE_NAME}..."
    # Create zone first — zones/import requires it to exist; ignore error if already present
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/zones/create?token=${DNS_API_TOKEN}&zone=${_ZONE_NAME}&type=Primary" \
        > /dev/null 2>&1 || true
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/zones/import?token=${DNS_API_TOKEN}&zone=${_ZONE_NAME}&overwrite=true" \
        -F "zoneFile=@$1" \
        || { echo "sync-zones: import failed for ${_ZONE_NAME}" >&2; return 1; }
}

if [ "${IMPORT_ALL}" = "true" ]; then
    configure_server
    echo "sync-zones: importing all zones from ${BASEDIR}/zones/..."
    ERRORS=0
    for DB_FILE in "${BASEDIR}/zones"/*.db; do
        import_zone "${DB_FILE}" || ERRORS=$((ERRORS + 1))
    done
    [ "${ERRORS}" -eq 0 ] || die "sync-zones: ${ERRORS} zone(s) failed to import."
    echo "sync-zones: all zones imported."
    exit 0
fi

# Written by ./update once it has applied the host config at that commit.
# Keep in sync with ./update.
APPLIED_HEAD_FILE="/var/lib/credfeto-adguard-home/applied-head"

# Paths whose changes only take effect when ./update runs: the firewall
# and egress rules (update), the dynamic egress ipset refresher and its
# timer, and the container definition.
HOST_CONFIG_PATHS="update docker-compose.yml scripts/refresh-egress-ipsets scripts/dns-egress-refresh.service scripts/dns-egress-refresh.timer scripts/github-egress-ranges"

# Re-run ./update when the checkout holds host-config changes that were
# never applied since the commit ./update last recorded. With no usable
# record (a node set up before this existed, or a commit that is no
# longer in the history) ./update runs once to establish one. ./update
# is idempotent and finishes with sync-zones --all, so every zone is
# re-imported too. Exits the script when it runs.
run_update() {
    echo "sync-zones: running ./update to apply host config ($1)..."
    "${BASEDIR}/update" || die "sync-zones: ./update failed; will retry on the next run."
    echo "sync-zones: done (./update applied host config and imported all zones)."
    exit 0
}

apply_host_config_if_changed() {
    _head="$(git -C "${BASEDIR}" rev-parse HEAD)"
    _applied="$(cat "${APPLIED_HEAD_FILE}" 2> /dev/null || true)"
    if [ -z "${_applied}" ] || ! git -C "${BASEDIR}" cat-file -e "${_applied}^{commit}" 2> /dev/null; then
        run_update "no applied-commit record"
    fi
    [ "${_applied}" != "${_head}" ] || return 0

    # shellcheck disable=SC2086 # HOST_CONFIG_PATHS is a word list
    _changed="$(git -C "${BASEDIR}" diff --name-only "${_applied}..${_head}" -- ${HOST_CONFIG_PATHS})"
    [ -n "${_changed}" ] || return 0

    echo "sync-zones: host config changed since ${_applied}:"
    printf '  %s\n' ${_changed}
    run_update "changed since last apply"
}

# Refresh the dynamic egress ipsets (github.com etc.) on every run, BEFORE
# the pull: the pull itself needs github.com, whose address rotates often,
# so a stale set would block the very fetch that keeps this host current.
# A failed refresh is only a warning; the pull below then reports the real
# outcome. dns-egress-refresh.timer still runs it between syncs too.
refresh_egress_ipsets() {
    _refresh="/usr/local/bin/refresh-egress-ipsets"
    if [ ! -x "${_refresh}" ]; then
        echo "sync-zones: warning: ${_refresh} not installed; run ./update" >&2
        return 0
    fi
    echo "sync-zones: refreshing egress ipsets..."
    "${_refresh}" || echo "sync-zones: warning: egress ipset refresh failed" >&2
}

refresh_egress_ipsets

PREV_HEAD="$(git -C "${BASEDIR}" rev-parse HEAD)"

git -C "${BASEDIR}" pull

NEW_HEAD="$(git -C "${BASEDIR}" rev-parse HEAD)"

apply_host_config_if_changed

if [ "${PREV_HEAD}" = "${NEW_HEAD}" ]; then
    echo "sync-zones: no changes pulled, nothing to do."
    exit 0
fi

CHANGED_ZONES="$(git -C "${BASEDIR}" diff --name-only "${PREV_HEAD}..${NEW_HEAD}" -- 'zones/*.db')"

if [ -z "${CHANGED_ZONES}" ]; then
    echo "sync-zones: no zone changes in this pull, skipping import."
    exit 0
fi

echo "sync-zones: zone changes detected, importing..."
ERRORS=0
for ZONE_FILE in ${CHANGED_ZONES}; do
    ABS_FILE="${BASEDIR}/${ZONE_FILE}"
    if [ ! -f "${ABS_FILE}" ]; then
        echo "sync-zones: $(basename "${ZONE_FILE}" .db) removed from git — delete via admin UI if needed"
        continue
    fi
    import_zone "${ABS_FILE}" || ERRORS=$((ERRORS + 1))
done

[ "${ERRORS}" -eq 0 ] || die "sync-zones: ${ERRORS} zone(s) failed to import."
echo "sync-zones: done."
