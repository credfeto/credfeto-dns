#!/bin/sh

set -e

die() {
    echo
    echo "$@"
    exit 1
}

IMPORT_ALL=false
case "$1" in
    --all) IMPORT_ALL=true ;;
    "")    ;;
    *)     die "Usage: sync-zones [--all]" ;;
esac

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$SCRIPTDIR")"

ENV_FILE="${SCRIPTDIR}/.env"
if [ ! -f "${ENV_FILE}" ]; then
    echo "sync-zones: no .env at ${ENV_FILE} — skipping zone sync."
    echo "sync-zones: copy scripts/.env.example and set DNS_API_TOKEN to enable."
    exit 0
fi

DNS_API_TOKEN="$(grep -E '^[[:space:]]*DNS_API_TOKEN[[:space:]]*=' "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
if [ -z "${DNS_API_TOKEN}" ]; then
    echo "sync-zones: DNS_API_TOKEN not set in ${ENV_FILE} — skipping zone sync."
    exit 0
fi

DNS_API_URL="$(grep -E '^[[:space:]]*DNS_API_URL[[:space:]]*=' "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
DNS_API_URL="${DNS_API_URL:-https://localhost:53443}"

configure_server() {
    echo "sync-zones: configuring server settings..."
    # dnsTlsCertificatePath=cert.pfx points to the self-signed cert generated by
    # the update script at /data/technitium/config/cert.pfx (mounted as /etc/dns/).
    # dnsTlsCertificatePassword is intentionally empty — the cert has no password.
    # enableDnsOverTcpProxy + dnsReverseProxyNetworkACL: DNS-over-TLS is terminated
    # by Traefik on the two proxies and forwarded to port 538 with PROXY protocol v2;
    # only the proxies are trusted to supply the real client address.
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/settings/set?token=${DNS_API_TOKEN}&webServiceEnableHttp3=true&enableDnsOverHttps=true&dnsOverHttpsPort=443&enableDnsOverHttp3=true&dnsTlsCertificatePath=cert.pfx&dnsTlsCertificatePassword=&enableDnsOverTcpProxy=true&dnsOverTcpProxyPort=538&dnsReverseProxyNetworkACL=192.168.140.250,192.168.140.251,2a02:8010:61d5:140::250,2a02:8010:61d5:140::251" \
        > /dev/null \
        || echo "sync-zones: warning: server settings update failed" >&2
}

# Query logging: the Log Exporter app sends every query as RFC 5424 syslog
# (UDP) to VictoriaLogs on monitoring.lan (credfeto-monitoring), configured
# from scripts/log-exporter.json. Every node reports the hostname
# "dns-server", so VictoriaLogs records the sender as remote_ip.
LOG_EXPORTER_APP="Log Exporter"
LOG_EXPORTER_URL="https://download.technitium.com/dns/apps/LogExporterApp-v3.1.1.zip"

configure_log_exporter() {
    echo "sync-zones: configuring ${LOG_EXPORTER_APP}..."
    _apps="$(curl -sf -k "${DNS_API_URL}/api/apps/list?token=${DNS_API_TOKEN}")" \
        || { echo "sync-zones: warning: could not list apps" >&2; return 0; }
    if ! printf '%s' "${_apps}" | grep -q "\"name\":\"${LOG_EXPORTER_APP}\""; then
        curl -sf -k -X POST "${DNS_API_URL}/api/apps/downloadAndInstall?token=${DNS_API_TOKEN}" \
            --data-urlencode "name=${LOG_EXPORTER_APP}" --data-urlencode "url=${LOG_EXPORTER_URL}" \
            > /dev/null \
            || { echo "sync-zones: warning: ${LOG_EXPORTER_APP} install failed" >&2; return 0; }
    fi
    curl -sf -k -X POST "${DNS_API_URL}/api/apps/config/set?token=${DNS_API_TOKEN}" \
        --data-urlencode "name=${LOG_EXPORTER_APP}" --data-urlencode "config@${SCRIPTDIR}/log-exporter.json" \
        > /dev/null \
        || echo "sync-zones: warning: ${LOG_EXPORTER_APP} config update failed" >&2
}

# Hide internal names from untrusted VLANs: IoT (192.168.34.0/24), CCTV
# (192.168.60.0/24) and Printers (192.168.66.0/24), plus their IPv6 /64s, get REFUSED for the LAN zones (lan, *.lan), every
# reverse zone (*.arpa) and the internal *.markridgwell.com zones. Only the
# names those devices actually use stay open to them: the TRMNL display's
# server (trmnl, trmnl-assets) and Home Assistant, which the H&T sensors
# report to. Every other client is allowed as before. Public DoH/DoT
# resolver zones (dns.google, *.cloudflare-dns.com, ...) are left open.
RESTRICTED_QUERY_ACL="!192.168.34.0/24,!2a02:8010:61d5:34::/64,!192.168.60.0/24,!2a02:8010:61d5:60::/64,!192.168.66.0/24,!2a02:8010:61d5:66::/64,0.0.0.0/0,::/0"
OPEN_TO_UNTRUSTED_ZONES="trmnl.markridgwell.com trmnl-assets.markridgwell.com homeassistant.markridgwell.com"

zone_is_restricted() {
    for _open in ${OPEN_TO_UNTRUSTED_ZONES}; do
        [ "$1" != "${_open}" ] || return 1
    done
    case "$1" in
        lan | *.lan | *.arpa | *.markridgwell.com) return 0 ;;
        *) return 1 ;;
    esac
}

# Applied to every zone on every run (it is idempotent and cheap), so a zone
# that is added, re-created or imported always ends up with the right access,
# and a setting changed by hand is put back on the next run.
set_query_access() {
    if zone_is_restricted "$1"; then
        curl -sf -k -X POST "${DNS_API_URL}/api/zones/options/set?token=${DNS_API_TOKEN}" \
            --data-urlencode "zone=$1" \
            --data-urlencode "queryAccess=UseSpecifiedNetworkACL" \
            --data-urlencode "queryAccessNetworkACL=${RESTRICTED_QUERY_ACL}" \
            > /dev/null
    else
        curl -sf -k -X POST "${DNS_API_URL}/api/zones/options/set?token=${DNS_API_TOKEN}" \
            --data-urlencode "zone=$1" \
            --data-urlencode "queryAccess=Allow" \
            > /dev/null
    fi
}

apply_query_access() {
    echo "sync-zones: applying zone query access..."
    _failed=0
    for _db in "${BASEDIR}/zones"/*.db; do
        _zone="$(basename "${_db}" .db)"
        set_query_access "${_zone}" || { echo "sync-zones: warning: query access update failed for ${_zone}" >&2; _failed=$((_failed + 1)); }
    done
    [ "${_failed}" -eq 0 ] || echo "sync-zones: warning: ${_failed} zone(s) did not get their query access set; retried on the next run" >&2
}

import_zone() {
    _ZONE_NAME="$(basename "$1" .db)"
    echo "sync-zones: importing ${_ZONE_NAME}..."
    # Create zone first — zones/import requires it to exist; ignore error if already present
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/zones/create?token=${DNS_API_TOKEN}&zone=${_ZONE_NAME}&type=Primary" \
        > /dev/null 2>&1 || true
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/zones/import?token=${DNS_API_TOKEN}&zone=${_ZONE_NAME}&overwrite=true" \
        -F "zoneFile=@$1" \
        || { echo "sync-zones: import failed for ${_ZONE_NAME}" >&2; return 1; }
}

if [ "${IMPORT_ALL}" = "true" ]; then
    configure_server
    configure_log_exporter
    echo "sync-zones: importing all zones from ${BASEDIR}/zones/..."
    ERRORS=0
    for DB_FILE in "${BASEDIR}/zones"/*.db; do
        import_zone "${DB_FILE}" || ERRORS=$((ERRORS + 1))
    done
    apply_query_access
    [ "${ERRORS}" -eq 0 ] || die "sync-zones: ${ERRORS} zone(s) failed to import."
    echo "sync-zones: all zones imported."
    exit 0
fi

# Written by ./update once it has applied the host config at that commit.
# Keep in sync with ./update.
APPLIED_HEAD_FILE="/var/lib/credfeto-adguard-home/applied-head"

# Paths whose changes only take effect when ./update runs: the inbound
# firewall rules (update), the egress table builder, its units and the
# GitHub ranges it reads, and the container definition.
HOST_CONFIG_PATHS="update docker-compose.yml scripts/egress scripts/dns-egress-refresh.service scripts/dns-egress-refresh.timer scripts/github-egress-ranges"

# Re-run ./update when the checkout holds host-config changes that were
# never applied since the commit ./update last recorded. With no usable
# record (a node set up before this existed, or a commit that is no
# longer in the history) ./update runs once to establish one. ./update
# is idempotent and finishes with sync-zones --all, so every zone is
# re-imported too. Exits the script when it runs.
run_update() {
    echo "sync-zones: running ./update to apply host config ($1)..."
    "${BASEDIR}/update" || die "sync-zones: ./update failed; will retry on the next run."
    echo "sync-zones: done (./update applied host config and imported all zones)."
    exit 0
}

apply_host_config_if_changed() {
    _head="$(git -C "${BASEDIR}" rev-parse HEAD)"
    _applied="$(cat "${APPLIED_HEAD_FILE}" 2> /dev/null || true)"
    if [ -z "${_applied}" ] || ! git -C "${BASEDIR}" cat-file -e "${_applied}^{commit}" 2> /dev/null; then
        run_update "no applied-commit record"
    fi
    [ "${_applied}" != "${_head}" ] || return 0

    # shellcheck disable=SC2086 # HOST_CONFIG_PATHS is a word list
    _changed="$(git -C "${BASEDIR}" diff --name-only "${_applied}..${_head}" -- ${HOST_CONFIG_PATHS})"
    [ -n "${_changed}" ] || return 0

    echo "sync-zones: host config changed since ${_applied}:"
    printf '  %s\n' ${_changed}
    run_update "changed since last apply"
}

# Refresh the egress table (github.com etc.) on every run, BEFORE the
# pull: the pull itself needs github.com, whose address rotates often, so
# a stale set would block the very fetch that keeps this host current. A
# failed refresh is only a warning; the pull below then reports the real
# outcome. dns-egress-refresh.timer still runs it between syncs too. A
# node whose ./update has not yet installed dns-egress still has the
# firewalld ipset refresher it replaces.
refresh_egress() {
    for _refresh in /usr/local/bin/dns-egress /usr/local/bin/refresh-egress-ipsets; do
        [ -x "${_refresh}" ] || continue
        echo "sync-zones: refreshing egress rules..."
        "${_refresh}" || echo "sync-zones: warning: egress refresh failed" >&2
        return 0
    done
    echo "sync-zones: warning: /usr/local/bin/dns-egress not installed; run ./update" >&2
}

refresh_egress

# Self-heal query-log export. The Log Exporter's UDP syslog sink stops for good
# when VictoriaLogs is unreachable for a while (for example while the
# monitoring VM reboots) and the app never recreates it, so queries stop
# reaching VictoriaLogs while everything looks healthy. Every run, ask
# VictoriaLogs (same host as the syslog target in log-exporter.json, port 9428)
# whether it has seen this node in the last 15 minutes. If it answers with
# nothing, re-save the app config, which recreates the sink. If VictoriaLogs
# can't be reached, do nothing: the next run tries again.
ensure_log_export() {
    _vl_host="$(sed -n 's/.*"address":[[:space:]]*"\([^"]*\)".*/\1/p' "${SCRIPTDIR}/log-exporter.json" | head -n 1)"
    [ -n "${_vl_host}" ] || return 0
    _src="$(ip -4 -o route get "${_vl_host}" 2> /dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p')"
    [ -n "${_src}" ] || return 0
    _seen="$(curl -sf -m 15 -G "http://${_vl_host}:9428/select/logsql/query" \
        --data-urlencode "query=_time:15m hostname:dns-server remote_ip:${_src} | limit 1")" \
        || { echo "sync-zones: warning: VictoriaLogs not reachable; query-log export not checked" >&2; return 0; }
    [ -n "${_seen}" ] && return 0
    echo "sync-zones: no query logs from ${_src} in VictoriaLogs for 15 minutes; re-applying ${LOG_EXPORTER_APP} config"
    configure_log_exporter
}

ensure_log_export

PREV_HEAD="$(git -C "${BASEDIR}" rev-parse HEAD)"

git -C "${BASEDIR}" pull

NEW_HEAD="$(git -C "${BASEDIR}" rev-parse HEAD)"

apply_host_config_if_changed

CHANGED_ZONES="$(git -C "${BASEDIR}" diff --name-only "${PREV_HEAD}..${NEW_HEAD}" -- 'zones/*.db')"

# Import before setting access, so a newly created zone gets its ACL in this run.
import_changed_zones() {
    ERRORS=0
    for ZONE_FILE in ${CHANGED_ZONES}; do
        ABS_FILE="${BASEDIR}/${ZONE_FILE}"
        if [ ! -f "${ABS_FILE}" ]; then
            echo "sync-zones: $(basename "${ZONE_FILE}" .db) removed from git — delete via admin UI if needed"
            continue
        fi
        import_zone "${ABS_FILE}" || ERRORS=$((ERRORS + 1))
    done
}

if [ -n "${CHANGED_ZONES}" ]; then
    echo "sync-zones: zone changes detected, importing..."
    import_changed_zones
fi

apply_query_access

if [ "${PREV_HEAD}" = "${NEW_HEAD}" ]; then
    echo "sync-zones: no changes pulled, nothing to do."
    exit 0
fi

if [ -z "${CHANGED_ZONES}" ]; then
    echo "sync-zones: no zone changes in this pull, skipping import."
    exit 0
fi

[ "${ERRORS}" -eq 0 ] || die "sync-zones: ${ERRORS} zone(s) failed to import."
echo "sync-zones: done."
