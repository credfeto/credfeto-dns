$ORIGIN lan.
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

host    IN AAAA 2a02:8010:61d5:1::10
other   IN AAAA 2a02:8010:61d5:1::abc
public  IN AAAA 2001:db8::1 ; not internal, so needs no PTR
