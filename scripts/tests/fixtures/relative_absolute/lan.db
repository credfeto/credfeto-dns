; no $ORIGIN: the origin comes from the file name
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

@               IN A 192.168.1.1
host            IN A 192.168.1.10
other.lan.      300 IN A 192.168.1.11
                IN 300 A 192.168.1.12 ; owner carried over from the previous record
$ORIGIN sub.lan.
deep            IN A 192.168.1.13
