$ORIGIN 140.168.192.in-addr.arpa.
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

; .250/.251 (::250/::251) are the reverse-proxy nodes; PTR targets the node's own
; zone record, not any of the service zones that copy its address
; (see ai/local/dns-zones.instructions.md).
251 IN PTR 02.proxy.markridgwell.com.
