$ORIGIN 2.168.192.in-addr.arpa.
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

2   IN PTR stairs-01.network.lan.
3   IN PTR stairs-02.network.lan.
4   IN PTR office.network.lan.
5   IN PTR bedroom.network.lan.
