$ORIGIN 0.7.1.0.5.d.1.6.0.1.0.8.2.0.a.2.ip6.arpa.
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

