$ORIGIN 42.168.192.in-addr.arpa.
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

101 IN PTR dns-01.dns.lan.
102 IN PTR dns-02.dns.lan.
103 IN PTR dns-03.dns.lan.
104 IN PTR dns-04.dns.lan.
105 IN PTR dns-05.dns.lan.
106 IN PTR dns-06.dns.lan.
