#! /bin/sh

die() {
    echo
    echo "$@"
    exit 1
}

# FIREWALL_CHANGED tracks whether any permanent firewall config
# (inbound zone rules, or retiring the old firewalld egress policy) was
# reload can be skipped on idempotent re-runs. The reload runs from
# traps so that a die() or an interrupt (Ctrl-C, dropped ssh) after
# permanent config was mutated still activates it - otherwise runtime
# strands behind permanent config and re-runs (finding everything
# already present) would never reload.
FIREWALL_CHANGED=false
finish_firewall() {
    if [ "${FIREWALL_CHANGED}" = "true" ]; then
        sudo firewall-cmd --reload
        FIREWALL_CHANGED=false
    fi
}
trap 'finish_firewall; exit 130' INT HUP TERM
trap 'finish_firewall' EXIT

allow_port() {
    PROTO="$1"
    PORT="$2"
    for SUBNET in "10.0.0.0/8" "192.168.0.0/16" "172.16.0.0/12"; do
        RULE="rule family=\"ipv4\" source address=\"${SUBNET}\" port protocol=\"${PROTO}\" port=\"${PORT}\" accept"
        if ! sudo firewall-cmd --query-rich-rule="${RULE}" --permanent > /dev/null 2>&1; then
            sudo firewall-cmd --permanent --add-rich-rule="${RULE}" || die "Failed to add firewall rule: ${RULE}"
            FIREWALL_CHANGED=true
        fi
    done
    for SUBNET in "fc00::/7" "fe80::/10" "2a02:8010:61d5::/48"; do
        RULE="rule family=\"ipv6\" source address=\"${SUBNET}\" port protocol=\"${PROTO}\" port=\"${PORT}\" accept"
        if ! sudo firewall-cmd --query-rich-rule="${RULE}" --permanent > /dev/null 2>&1; then
            sudo firewall-cmd --permanent --add-rich-rule="${RULE}" || die "Failed to add firewall rule: ${RULE}"
            FIREWALL_CHANGED=true
        fi
    done
}

# Allow a port only from specific hosts (single addresses, IPv4 or IPv6).
allow_port_from() {
    PROTO="$1"
    PORT="$2"
    shift 2
    for ADDR in "$@"; do
        case "${ADDR}" in
            *:*) FAMILY=ipv6 ;;
            *) FAMILY=ipv4 ;;
        esac
        RULE="rule family=\"${FAMILY}\" source address=\"${ADDR}\" port protocol=\"${PROTO}\" port=\"${PORT}\" accept"
        if ! sudo firewall-cmd --query-rich-rule="${RULE}" --permanent > /dev/null 2>&1; then
            sudo firewall-cmd --permanent --add-rich-rule="${RULE}" || die "Failed to add firewall rule: ${RULE}"
            FIREWALL_CHANGED=true
        fi
    done
}

block_port() {
    PROTO="$1"
    PORT="$2"
    RULE="rule port protocol=\"${PROTO}\" port=\"${PORT}\" reject"
    if ! sudo firewall-cmd --query-rich-rule="${RULE}" --permanent > /dev/null 2>&1; then
        sudo firewall-cmd --permanent --add-rich-rule="${RULE}" || die "Failed to add firewall rule: ${RULE}"
        FIREWALL_CHANGED=true
    fi
}

env_value() {
    grep -E "^[[:space:]]*$1[[:space:]]*=" "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

BASEDIR="$(dirname "$(readlink -f "$0")")"

# Keep in sync with scripts/sync-zones.
APPLIED_HEAD_FILE="/var/lib/credfeto-adguard-home/applied-head"

# docker compose (below) resolves docker-compose.yml relative to the
# current working directory, not BASEDIR - without this, running the
# script via an absolute/relative path from elsewhere fails with "no
# configuration file provided".
cd "${BASEDIR}" || die "Could not cd to ${BASEDIR}"

ENV_FILE="${BASEDIR}/.env"
if [ ! -f "${ENV_FILE}" ]; then
    die "No .env file found at ${ENV_FILE}. Create one with DNS_ADMIN_PASSWORD=<password>"
fi

DNS_ADMIN_PASSWORD="$(env_value DNS_ADMIN_PASSWORD)"
if [ -z "${DNS_ADMIN_PASSWORD}" ]; then
    die "DNS_ADMIN_PASSWORD is not set or is empty in ${ENV_FILE}"
fi

DNS_EGRESS_ENFORCE="$(env_value DNS_EGRESS_ENFORCE)"
# Enforcement is the default - set DNS_EGRESS_ENFORCE=false in .env to
# fall back to observation mode (rules present, unmatched egress logged
# but accepted) when validating a new node or diagnosing a gap.
DNS_EGRESS_ENFORCE="${DNS_EGRESS_ENFORCE:-true}"

git -C "${BASEDIR}" pull

sudo mkdir -p /data/technitium/config /data/technitium/logs

# Ensure bind (dig) is installed — used by the self-test script.
if ! command -v dig > /dev/null 2>&1; then
    echo "Installing bind (dig)..."
    sudo pacman -S --noconfirm bind || die "Failed to install bind"
fi

# Generate self-signed TLS certificate for DNS-over-HTTPS if not present.
# Technitium requires a separate cert for the DoH/DoT listener (cert.pfx),
# distinct from the admin web-console's self-signed cert.
CERT_FILE="/data/technitium/config/cert.pfx"
CERT_GENERATED=false
if [ ! -f "${CERT_FILE}" ]; then
    echo "Generating self-signed TLS certificate for DNS-over-HTTPS..."
    TMPDIR="$(mktemp -d)"
    HOSTNAME="$(cat /etc/hostname 2>/dev/null || echo dns-server)"
    openssl req -x509 -newkey rsa:2048 \
        -keyout "${TMPDIR}/key.pem" -out "${TMPDIR}/cert.pem" \
        -days 3650 -nodes \
        -subj "/CN=${HOSTNAME}" \
        2>/dev/null
    openssl pkcs12 -export \
        -out "${TMPDIR}/cert.pfx" \
        -inkey "${TMPDIR}/key.pem" \
        -in "${TMPDIR}/cert.pem" \
        -passout pass: \
        2>/dev/null
    sudo install -m 640 -o root -g root "${TMPDIR}/cert.pfx" "${CERT_FILE}"
    rm -rf "${TMPDIR}"
    echo "Certificate generated at ${CERT_FILE}"
    CERT_GENERATED=true
fi

docker compose up -d --remove-orphans || die "Could not start container"

# If the cert was freshly generated the DoH/DoT listener won't have bound port 443
# (Technitium only reads the cert path at startup). Force a restart so it picks it up.
if [ "${CERT_GENERATED}" = "true" ]; then
    echo "Restarting container so DoH/DoT listener picks up new certificate..."
    docker compose restart || die "Could not restart container"
fi


## Outbound (egress) lockdown: one nftables table, inet dns_egress, built
## and loaded by scripts/egress (installed as /usr/local/bin/dns-egress);
## see there and docs/network/egress-whitelist.md for the destination
## list. It is loaded and verified here, before any firewalld change, and
## the firewalld egress policy it replaces is only retired once it is in
## place (below), so egress is never unfiltered and never fully blocked.
## Enforcement (unmatched new connections dropped) is the default;
## DNS_EGRESS_ENFORCE=false gives observation mode (logged, not dropped).
# Keep the state directory in sync with scripts/egress.
EGRESS_STATE_DIR="/var/lib/credfeto-adguard-home"
EGRESS_ENFORCE="true"
if [ "${DNS_EGRESS_ENFORCE}" = "false" ]; then
    EGRESS_ENFORCE="false"
fi
sudo install -m 755 "${BASEDIR}/scripts/egress" /usr/local/bin/dns-egress || die "Failed to install dns-egress"
sudo install -d -m 755 /usr/local/share/credfeto-adguard-home
sudo install -m 644 "${BASEDIR}/scripts/github-egress-ranges" /usr/local/share/credfeto-adguard-home/github-egress-ranges \
    || die "Failed to install github-egress-ranges"
sudo install -d -m 755 "${EGRESS_STATE_DIR}"
printf '%s\n' "${EGRESS_ENFORCE}" | sudo tee "${EGRESS_STATE_DIR}/egress-enforce" > /dev/null \
    || die "Could not write ${EGRESS_STATE_DIR}/egress-enforce"
sudo /usr/local/bin/dns-egress || die "Failed to load the egress table; the previous egress rules are unchanged"
sudo nft list table inet dns_egress > /dev/null 2>&1 || die "Table inet dns_egress is not loaded; the previous egress rules are unchanged"

# The refresh unit runs dns-egress at boot (before Docker starts) and every
# 10 minutes from its timer. Let a refresh that is already running finish
# before its unit is replaced.
for _ in $(seq 1 120); do
    [ "$(systemctl show -p ActiveState --value dns-egress-refresh.service 2> /dev/null)" = "activating" ] || break
    sleep 1
done
sudo install -m 644 "${BASEDIR}/scripts/dns-egress-refresh.service" /etc/systemd/system/dns-egress-refresh.service
sudo install -m 644 "${BASEDIR}/scripts/dns-egress-refresh.timer" /etc/systemd/system/dns-egress-refresh.timer
sudo rm -f /usr/local/bin/refresh-egress-ipsets
sudo systemctl daemon-reload
sudo systemctl enable dns-egress-refresh.service dns-egress-refresh.timer > /dev/null 2>&1
# restart, not just enable --now: an already-active timer would keep its
# old (possibly stalled) schedule instead of picking up the new unit.
sudo systemctl restart dns-egress-refresh.timer

## Admin UI (HTTPS web console)
allow_port tcp 53443

# DNS
allow_port tcp 53
allow_port udp 53

# DNS-over-HTTPS
allow_port tcp 443
allow_port udp 443

# DNS-over-TCP-PROXY (538): DNS-over-TLS for dns.markridgwell.com is terminated
# by Traefik on the proxies, which forward here with PROXY protocol v2. Only
# the proxies may connect (they are also the only trusted reverse proxies in
# dnsReverseProxyNetworkACL, set by scripts/sync-zones).
allow_port_from tcp 538 192.168.140.250 192.168.140.251 2a02:8010:61d5:140::250 2a02:8010:61d5:140::251
# The proxies' Servers VLAN addresses are no longer in use.
for ADDR in 192.168.150.250 192.168.150.251 2a02:8010:61d5:150::250 2a02:8010:61d5:150::251; do
    case "${ADDR}" in
        *:*) FAMILY=ipv6 ;;
        *) FAMILY=ipv4 ;;
    esac
    RULE="rule family=\"${FAMILY}\" source address=\"${ADDR}\" port protocol=\"tcp\" port=\"538\" accept"
    if sudo firewall-cmd --query-rich-rule="${RULE}" --permanent > /dev/null 2>&1; then
        sudo firewall-cmd --permanent --remove-rich-rule="${RULE}" || die "Failed to remove firewall rule: ${RULE}"
        FIREWALL_CHANGED=true
    fi
done

# Explicitly block DHCP — Technitium includes a DHCP server but it should
# never serve on this host; reject at the firewall regardless of app config.
block_port udp 67
block_port udp 68

# Retire the firewalld egress policy and ipsets that inet dns_egress
# replaces (loaded and verified above). Their refresh reloaded firewalld
# every 10 minutes, and a firewalld killed mid-reload leaves its
# block-everything table behind. The reload in finish_firewall below
# removes them, together with any inbound rule change, in one go; after
# that nothing here reloads firewalld for egress.
if sudo firewall-cmd --state > /dev/null 2>&1; then
    if sudo firewall-cmd --permanent --info-policy=dns-egress > /dev/null 2>&1; then
        sudo firewall-cmd --permanent --delete-policy=dns-egress > /dev/null || die "Failed to delete the dns-egress policy"
        FIREWALL_CHANGED=true
    fi
    for IPSET in $(sudo firewall-cmd --permanent --get-ipsets); do
        case "${IPSET}" in
            dns-egress-*)
                sudo firewall-cmd --permanent --delete-ipset="${IPSET}" > /dev/null || die "Failed to delete ipset ${IPSET}"
                FIREWALL_CHANGED=true
                ;;
        esac
    done
fi

# Activate any changes now (the traps only cover abnormal exits from
# this point on - the flag is reset once reloaded).
finish_firewall

# A firewalld reload leaves other tables alone; confirm the egress table
# is still loaded (dns-egress reloads it if not, and is a no-op otherwise).
sudo /usr/local/bin/dns-egress || die "Failed to load the egress table"
sudo nft list table inet dns_egress > /dev/null 2>&1 || die "Table inet dns_egress is not loaded"

"${BASEDIR}/scripts/sync-zones" --all || die "Zone import failed"

# Record the commit whose host config (firewall/egress, compose, timers)
# is now live. scripts/sync-zones compares against this after each pull
# and re-runs ./update when a pulled commit changed any of that config,
# so fixes such as new egress allow-list entries don't sit in the
# checkout unapplied until someone runs ./update by hand.
sudo mkdir -p "$(dirname "${APPLIED_HEAD_FILE}")"
git -C "${BASEDIR}" rev-parse HEAD | sudo tee "${APPLIED_HEAD_FILE}" > /dev/null \
    || die "Could not record applied commit in ${APPLIED_HEAD_FILE}"
